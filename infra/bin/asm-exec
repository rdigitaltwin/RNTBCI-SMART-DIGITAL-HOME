#!/usr/bin/env python3
"""Resolve {{resolve:secretsmanager:...}} refs then exec a child command.

Secret plaintext stays in this process / the child argv only — never printed.
Compatible with the Agent Toolkit for AWS asm-exec resolve syntax.
"""
from __future__ import annotations

import json
import os
import re
import sys

import boto3
from botocore.exceptions import ClientError

RESOLVE_RE = re.compile(
    r"\{\{resolve:secretsmanager:([^}:]+)(?::SecretString(?::([^}:]*))?(?::([^}]*))?)?\}\}"
)


def _resolve_one(secret_id: str, json_key: str | None) -> str:
    region = None
    if secret_id.startswith("arn:aws:secretsmanager:"):
        parts = secret_id.split(":")
        if len(parts) > 3:
            region = parts[3]
    region = region or os.environ.get("AWS_REGION") or os.environ.get("AWS_DEFAULT_REGION") or "ap-south-1"
    client = boto3.client("secretsmanager", region_name=region)
    try:
        resp = client.get_secret_value(SecretId=secret_id)
    except ClientError as exc:
        print(f"asm-exec: failed to resolve secret id={secret_id!r}: {exc}", file=sys.stderr)
        sys.exit(1)
    raw = resp.get("SecretString") or ""
    if not json_key:
        return raw
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        print("asm-exec: secret is not JSON but a json-key was requested", file=sys.stderr)
        sys.exit(1)
    if json_key not in data:
        print(f"asm-exec: json-key {json_key!r} not found in secret", file=sys.stderr)
        sys.exit(1)
    return str(data[json_key])


def _expand(text: str) -> str:
    def repl(match: re.Match[str]) -> str:
        secret_id = match.group(1)
        json_key = match.group(2) or None
        return _resolve_one(secret_id, json_key)

    return RESOLVE_RE.sub(repl, text)


def main() -> None:
    args = sys.argv[1:]
    if args and args[0] == "--":
        args = args[1:]
    if not args:
        print("usage: asm-exec -- <command> [args...]", file=sys.stderr)
        sys.exit(2)
    expanded = [_expand(a) for a in args]
    # Never log expanded args (may contain secrets)
    os.execvp(expanded[0], expanded)


if __name__ == "__main__":
    main()
