# ==============================================================================
# RNTBCI Smart Home Digital Twin
# Example Environment Configuration
# ==============================================================================

# Application Settings
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Database Configuration (PostgreSQL)
# Required for application to start
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rntbci
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/rntbci
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security (JWT)
# If not set, the app will generate a secret and save it to jwt_secret.txt
# For production, you MUST set a strong randomly generated string here.
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (Optional)
# Used for Pub/Sub, WebSockets, and Caching.
# The application will run without Redis, but some real-time features may be limited.
REDIS_URL=redis://localhost:6379/0

# MQTT Integration (Optional)
# Used for the MQTT controller hub adapter
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# CORS & Rate Limiting
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://rntbci-project.vercel.app
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
